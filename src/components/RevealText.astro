---
// Título que entra por linhas mascaradas: cada palavra sobe de dentro de uma máscara, em
// cascata curta, quando o título aparece na tela. Palavras em "highlight" ficam em tom
// secundário. Sem JavaScript ou com "reduzir movimento", o texto já aparece parado.
// O tamanho diminui pela largura do próprio bloco (container query).
interface Props {
    text: string
    highlight?: string
    tag?: "h1" | "h2" | "h3" | "p"
    fontSize?: number
    color?: string
    align?: "left" | "center"
}
const { text, highlight = "", tag = "h2", fontSize = 64, color = "var(--ink)", align = "left" } = Astro.props
const Tag = tag
// Grupos separados por espaço normal podem quebrar linha; palavras unidas por espaço fixo
// (\u00a0) ficam sempre juntas. As duas últimas palavras sempre andam juntas: nunca sobra
// uma palavra sozinha na última linha.
const marks = highlight.split(" ").filter(Boolean)
const groups = text.split(" ").filter(Boolean)
if (groups.length > 2) groups.splice(-2, 2, groups.at(-2) + "\u00a0" + groups.at(-1))
let n = 0
const units = groups.map((g) => g.split("\u00a0").map((w) => ({ w, i: n++ })))
const label = text.replace(/\u00a0/g, " ")
// HTML montado sem espaços de formatação, para o espaçamento entre palavras ficar igual
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;")
const html = units
    .map((g) => `<span class="g" aria-hidden="true">${g.map((u) => `<span class="w"><span${marks.includes(u.w) ? ' class="hl"' : ""} style="--i:${Math.min(u.i, 17)}">${esc(u.w)}</span></span>`).join("&nbsp;")}</span>`)
    .join(" ")
const size = Math.round(fontSize * 0.78)
const mobile = Math.min(size, Math.max(28, Math.round(size * 0.5)))
const tablet = Math.min(size, Math.max(mobile, Math.round(size * 0.72)))
---

<div class="rt-box">
    <Tag class:list={["rt", "rv", align === "center" && "center"]} aria-label={label} style={`--size:${size}px;--tablet:${tablet}px;--mobile:${mobile}px;color:${color}`}>
        <Fragment set:html={html} />
    </Tag>
</div>

<style>
    .rt-box {
        width: 100%;
        container-type: inline-size;
    }
    .rt {
        margin: 0;
        width: 100%;
        font-family: var(--font);
        font-weight: 700;
        font-size: var(--size);
        line-height: 1;
        letter-spacing: -0.035em;
        display: block;
        word-spacing: 0.02em;
        text-wrap: balance;
    }
    .rt :global(.g) {
        white-space: nowrap;
    }
    .center {
        text-align: center;
    }
    .rt :global(.w) {
        display: inline-block;
        overflow: hidden;
        padding-bottom: 0.12em;
        margin-bottom: -0.12em;
    }
    .rt :global(.w > span) {
        display: inline-block;
    }
    .rt :global(.hl) {
        opacity: 0.42;
    }
    @container (max-width: 759px) {
        .rt {
            font-size: var(--tablet);
        }
    }
    @container (max-width: 559px) {
        .rt {
            font-size: var(--mobile);
            line-height: 1.08;
        }
    }
</style>
