---
// Faixa escura no fim de cada case, levando ao próximo.
import PillButton from "./PillButton"

interface Props {
    name: string
    href: string
}
const { name, href } = Astro.props
---

<section class="next dark">
    <p class="h3">Próximo case → {name}</p>
    <PillButton client:visible primary ink="#FAFAF7" label={`Conferir ${name} ↗`} link={href} />
</section>
