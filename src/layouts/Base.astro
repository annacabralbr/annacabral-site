---
import "../styles/global.css"
import FloatingDock from "../components/FloatingDock"

interface Props {
    title: string
    description: string
    back?: boolean
    lang?: "pt" | "en"
}
const { title, description, back = false, lang = "pt" } = Astro.props
const en = lang === "en"
const home = en ? "/en/" : "/"
// endereço da mesma página no outro idioma
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const altPath = en ? path.replace(/^\/en/, "") || "/" : path === "/" ? "/en/" : "/en" + path
const t = en
    ? { cases: "Work", about: "About", process: "How I work", back: "← Anna Cabral", nav: "Main", other: "PT", otherLabel: "Versão em português", dock: "Let's talk" }
    : { cases: "Cases", about: "Sobre", process: "Como trabalho", back: "← Anna Cabral", nav: "Principal", other: "EN", otherLabel: "English version", dock: "Vamos conversar" }
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang={en ? "en" : "pt-BR"}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta name="theme-color" content="#FAFAF7" />
        <link rel="alternate" hreflang={en ? "pt-BR" : "en"} href={new URL(altPath, Astro.site)} />
        <script is:inline>document.documentElement.classList.add("js")</script>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </head>
    <body>
        <header class="nav">
            {
                back ? (
                    <a class="navlink" href={home}>
                        <span class="u">{t.back}</span>
                    </a>
                ) : (
                    <a class="brand" href={home}>
                        Anna Cabral
                    </a>
                )
            }
            <nav class="nav-links" aria-label={t.nav}>
                {
                    !back && (
                        <>
                            <a class="navlink" href={`${home}#cases`}>
                                <span class="u">{t.cases}</span>
                            </a>
                            <a class="navlink hide-phone" href={`${home}#sobre`}>
                                <span class="u">{t.about}</span>
                            </a>
                            <a class="navlink hide-phone" href={`${home}#processo`}>
                                <span class="u">{t.process}</span>
                            </a>
                        </>
                    )
                }
                <a class="navlink" href="https://www.linkedin.com/in/annapaulacabral" target="_blank" rel="noopener noreferrer">
                    <span class="u">LinkedIn ↗</span>
                </a>
                <a class="navlink" href={altPath} hreflang={en ? "pt-BR" : "en"} lang={en ? "pt-BR" : "en"} aria-label={t.otherLabel}>
                    <span class="u">{t.other}</span>
                </a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <slot name="after" />
        {!back && <FloatingDock client:idle label={t.dock} />}
        <script>
            // anima títulos e blocos quando entram na tela; sem suporte, mostra tudo
            const items = document.querySelectorAll(".rv, .fade")
            if (!("IntersectionObserver" in window)) items.forEach((el) => el.classList.add("in"))
            else {
                const io = new IntersectionObserver(
                    (entries) => {
                        for (const e of entries) {
                            if (e.isIntersecting) {
                                e.target.classList.add("in")
                                io.unobserve(e.target)
                            }
                        }
                    },
                    { rootMargin: "0px 0px -8% 0px" },
                )
                items.forEach((el) => io.observe(el))
            }
        </script>
    </body>
</html>
